<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Audiowide&family=Funnel+Display:wght@300..800&family=Funnel+Sans:ital,wght@0,300..800;1,300..800&family=Ubuntu+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/bundle.css">
    <title>{{ title }}</title>

    <!-- Primary Meta Tags -->
    <meta name="title" content="{{ title }}" />
    <meta name="description" content="Conteúdo tech toda semana." />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://wendryl.github.io/blog/" />
    <meta property="og:title" content="{{ title }}" />
    <meta property="og:description" content="Conteúdo tech toda semana." />
    <meta property="og:image" content="/assets/profile.jpeg" />

    <!-- X (Twitter) -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://wendryl.github.io/blog/" />
    <meta property="twitter:title" content="{{ title }}" />
    <meta property="twitter:description" content="Conteúdo tech toda semana." />
    <meta property="twitter:image" content="/assets/profile.jpeg" />

    <!-- Meta Tags Generated with https://metatags.io -->
  </head>
  <body>
    <nav>
      <ul class="links container">
        <li>
          <a href="/">
            Home
          </a>
        </li>
        <li>
          <a href="/about">
            Sobre
          </a>
        </li>
      </ul>
    </nav>
    <div class="container">
      {{ content | safe }}
    </div>
    <span class="copy">
      Copyright &copy; Wendryl Santos Tecnologia - {% year %}
    </span>
  </body>
</html>
